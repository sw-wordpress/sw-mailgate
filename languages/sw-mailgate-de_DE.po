msgid "The export could not be started."
msgstr "Der Export konnte nicht gestartet werden."

#: src/Admin/Log_Page.php:236
msgid "This message cannot be resent. Stored content and an active connection are required; attachments are not retained."
msgstr "Diese Nachricht kann nicht erneut gesendet werden. Gespeicherter Inhalt und eine aktive Verbindung sind erforderlich; Anhänge werden nicht aufbewahrt."

#: src/Admin/Log_Page.php:268
msgid "Mailgate delivery"
msgstr "Mailgate-Zustellung"

#: src/Admin/Log_Page.php:274
msgid "Final outcomes per message. Only retained log entries are counted."
msgstr "Endergebnisse je Nachricht. Es werden nur aufbewahrte Protokolleinträge gezählt."

