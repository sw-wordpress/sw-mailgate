msgstr "Letzte %1$d Tage: %2$d gesendet, %3$d fehlgeschlagen."

#. translators: 1: delivered count, 2: bounced count, 3: complaint count, 4: message bounce percentage
#: src/Admin/Log_Page.php:286
#, php-format
msgid "%1$d delivered, %2$d bounced, %3$d complained. Message bounce rate: %4$s%% of accepted messages (tracking may be incomplete)."
msgstr "%1$d zugestellt, %2$d unzustellbar, %3$d Spam-Beschwerden. Nachrichtenbezogene Unzustellbarkeitsrate: %4$s%% der angenommenen Nachrichten (Tracking kann unvollständig sein)."

#. translators: 1: partially delivered messages, 2: messages with uncertain delivery
