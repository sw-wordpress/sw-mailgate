#, php-format
msgid "%1$d partial deliveries, %2$d uncertain deliveries. Check outcomes before retrying."
msgstr "%1$d teilweise zugestellt, %2$d mit unklarer Zustellung. Vor erneutem Versand Ergebnisse prüfen."

